# Copy to .env and fill in. Never commit .env.

# SMTP: your mail host (cPanel webmail: mail.yourdomain.com, port 465 SSL or 587 STARTTLS).
# Gmail: smtp.gmail.com / 587 with an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password

SENDER_NAME=Your Name
SENDER_EMAIL=you@example.com
REPLY_TO=

# Unsubscribe link or address, added as a footer and List-Unsubscribe header.
# Put addresses that opt out in unsubscribed.txt (one per line).
UNSUBSCRIBE=mailto:you@example.com?subject=unsubscribe

# Emails per minute. Keep this modest: hosts throttle or block fast senders
# (shared/cPanel hosts often cap sends per hour; personal Gmail allows ~500/day).
SEND_RATE_PER_MIN=20

# Only needed for --personalize
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
